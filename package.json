{
  "name": "sortes",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "NODE_ENV=development bun --watch server.ts",
    "start": "NODE_ENV=production bun server.ts",
    "typecheck": "bun x --bun --no-install tsc --noEmit",
    "test": "NODE_ENV=test bun x --bun --no-install remix test",
    "test:server": "NODE_ENV=test bun x --bun --no-install remix test --type server",
    "test:browser": "NODE_ENV=test bun x --bun --no-install remix test --type browser --type e2e",
    "test:watch": "NODE_ENV=test bun x --bun --no-install remix test --watch",
    "format": "bun fmt app tests '*.{ts,tsx,json,yml,toml}' .github",
    "format:check": "bun fmt --check app tests '*.{ts,tsx,json,yml,toml}' .github",
    "lint": "bun x --bun --no-install biome check .",
    "check": "bun run format:check && bun run lint",
    "check:fix": "bun fmt app tests '*.{ts,tsx,json,yml,toml}' .github && bun x --bun --no-install biome check --write .",
    "verify": "bun run check && bun run typecheck && bun run test",
    "hooks:install": "bun x --bun --no-install lefthook install",
    "doctor": "bun x --bun --no-install remix doctor"
  },
  "dependencies": {
    "remix": "3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "lefthook": "2.2.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  }
}
