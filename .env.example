# Host the server binds to. Defaults to 0.0.0.0 (all interfaces) if unset.
HOST=0.0.0.0

# Port the server listens on. Defaults to 44100 if unset.
PORT=44100

# One of: development, production, test. Defaults to development if unset.
# Set to "production" for the built container/deployment startup path.
NODE_ENV=development
