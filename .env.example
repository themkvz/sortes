# Host the server binds to. Defaults to 0.0.0.0 (all interfaces) if unset.
HOST=0.0.0.0

# Port the server listens on. Defaults to 44100 if unset.
PORT=44100

# One of: development, production, test. Defaults to development if unset.
# Set to "production" for the built container/deployment startup path.
NODE_ENV=development

# Key that seals the in-progress reading saved in the HttpOnly `sortes_reading` session cookie.
# Required in production: a random value of at least 32 characters, for example
# `openssl rand -base64 32`. Leave empty in development and test to use a temporary
# per-process key. Changing it discards saved readings; they start fresh.
READING_STATE_SECRET=
